{
  "name": "gitfolio",
  "main": "src/index.js",
  // 2026-03-24+ is required for env.BROWSER.quickAction()
  "compatibility_date": "2026-03-24",
  // the only thing a fork needs to change
  "vars": {
    "GITHUB_USER": "cpwillis",
    // optional: extra repo names to leave out, comma separated. A repo whose homepage is the site
    // you are looking at is hidden automatically, so this is only for the cases that cannot cover.
    "HIDE_REPOS": "",
    // hosts allowed to serve /<username> for anyone. Leave empty for a personal deployment: the
    // site then only ever serves GITHUB_USER, whatever path is requested.
    "MULTI_USER_HOSTS": "gitfolio.cpwillis.dev,gitfolio.online"
  },
  "observability": {
    "enabled": true
  },
  // so each deploy starts from a cold data cache without editing a constant
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "browser": {
    "binding": "BROWSER",
    // local dev only: proxy to real Browser Rendering instead of a local stub
    "remote": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // only the dynamic routes hit the Worker; the page itself is served straight from assets
    // /<username> has no matching asset, so unmatched paths fall back to the page
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/shot/*", "/favicon.ico", "/favicon.svg", "/apple-touch-icon.png"]
  }
}
